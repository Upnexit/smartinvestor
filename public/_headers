# Caching headers for Smart Click BD

# Service worker and version check must NEVER be cached by HTTP proxies or browsers
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/version.json
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# HTML documents should always revalidate so fresh asset hashes are picked up
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# Static hashed assets can be cached aggressively
/assets/*
  Cache-Control: public, max-age=31536000, immutable
